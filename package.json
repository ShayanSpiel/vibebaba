{
  "name": "vb",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon",
    "dev:direct": "next dev",
    "dev:clean": "./scripts/clean-dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup:validation-db": "npx tsx scripts/setup-validation-db.ts",
    "kill:dev": "ps aux | grep -E 'next-server|next dev|node.*\\.next' | grep -v grep | awk '{print $2}' | xargs kill -9 2>/dev/null || true",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "clean:full": "rm -rf .next tsconfig.tsbuildinfo pocketbase/*.db-wal deployment-server/pb_data/*.db-wal",
    "clean:test-files": "rm -f test-*.js test-*.sh fix-and-test-*.js verify-*.sh check-*.sh",
    "clean:deployments": "find deployment-server/builds -type d -mtime +30 -exec rm -rf {} + 2>/dev/null || true",
    "clean:old-builds": "find deployment-server/deployments -type d -mtime +30 -exec rm -rf {} + 2>/dev/null || true",
    "clean:all-old": "npm run clean:deployments && npm run clean:old-builds",
    "analyze": "ANALYZE=true npm run build",
    "analyze:size": "du -sh node_modules .next deployment-server pocketbase 2>/dev/null || du -sh node_modules deployment-server pocketbase",
    "analyze:deps": "npm list --depth=0",
    "server": "cd deployment-server && npm run dev",
    "server:manual": "cd deployment-server && npm run dev:manual",
    "server:delayed": "cd deployment-server && npm run dev:delayed",
    "server:reload": "cd deployment-server && npm run reload",
    "langsmith:setup-dataset": "npx tsx lib/langsmith/dataset-setup.ts",
    "langsmith:validate": "npx tsx lib/langsmith/validate-setup.ts",
    "langsmith:test-api-keys": "npx tsx lib/test-api-keys.ts",
    "langsmith:auto-experiment": "npx tsx lib/langsmith/run-auto-experiment.ts",
    "langsmith:continuous-opt": "npx tsx lib/langsmith/run-auto-experiment.ts continuous",
    "langsmith:setup-all-datasets": "npx tsx lib/langsmith/datasets/all-nodes-datasets.ts all",
    "langsmith:test-all": "npx tsx lib/langsmith/run-all-experiments.ts",
    "langsmith:test-founder": "npx tsx lib/langsmith/run-all-experiments.ts founder",
    "langsmith:test-pm": "npx tsx lib/langsmith/run-all-experiments.ts pm",
    "langsmith:test-ux": "npx tsx lib/langsmith/run-all-experiments.ts ux",
    "langsmith:test-backend": "npx tsx lib/langsmith/run-all-experiments.ts backend",
    "langsmith:test-frontend": "npx tsx lib/langsmith/run-all-experiments.ts frontend",
    "langsmith:continuous-all": "npx tsx lib/langsmith/run-all-experiments.ts continuous",
    "langsmith:generate-prompts": "npx tsx lib/langsmith/ai-prompt-generator.ts",
    "langsmith:evolve-prompts": "npx tsx lib/langsmith/prompt-evolver.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.1",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "compression-webpack-plugin": "^11.1.0",
    "eslint": "^9.38.0",
    "htmlhint": "^1.7.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.0.1",
    "@langchain/google-genai": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^17.2.3",
    "duck-duck-scrape": "^2.2.7",
    "framer-motion": "^12.23.24",
    "langsmith": "^0.3.77",
    "lucide-react": "^0.546.0",
    "nanoid": "^5.1.6",
    "next": "^15.5.6",
    "next-intl": "^4.3.12",
    "openai": "^6.6.0",
    "pocketbase": "^0.21.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tiktoken": "^1.0.15"
  }
}
