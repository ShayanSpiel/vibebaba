# PocketBase Database
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=your-admin@email.com
POCKETBASE_ADMIN_PASSWORD=your-secure-admin-password

# API Keys
MISTRAL_API_KEY=your-mistral-api-key
CODESTRAL_API_KEY=your-codestral-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
CRON_SECRET=your-secret-key-change-in-production

# PHASE 2: Pricing Configuration (Optional - allows dynamic pricing without deployment)
# Uncomment and modify to override default pricing
# PRICING_CONFIG_JSON={"packages":{"pro":{"prices":{"USD":12.99}}}}
# or use deep merge for specific changes:
# PRICING_CONFIG_JSON={"currency":{"exchangeRates":{"USD_TO_IRT":75000}}}

# MCP Server API Keys
GITHUB_TOKEN=your-github-token
BRAVE_API_KEY=your-brave-api-key
EXA_API_KEY=your-exa-api-key

# Additional MCP Server Configurations
FILESYSTEM_ALLOWED_DIRS=./templates,./generated,./components
SQLITE_DB_PATH=./data/analytics.db
PUPPETEER_HEADLESS=true

# Bolt Infrastructure Configuration
# Error Loop Prevention
ENABLE_ERROR_LOOP_DETECTION=true
MAX_ERROR_ATTEMPTS=3
ERROR_LOOP_TIME_WINDOW=60000

# File Tracking
ENABLE_FILE_TRACKING=true

# Runtime Error Reporting
ENABLE_RUNTIME_ERROR_REPORTING=true

# Request Throttling
ENABLE_AI_THROTTLING=true
AI_REQUEST_MIN_DELAY=1000
AI_REQUEST_MAX_CONCURRENT=1

# Error Tracking Database (optional - for analytics)
ENABLE_ERROR_TRACKING_DB=false

# LangGraph Workflow Configuration
# Set to 'false' to use legacy AI generation (for rollback)
USE_LANGGRAPH=true
